{
  "name": "hummingread-reader",
  "version": "2.0.0",
  "description": "HummingRead is a calm RSVP speed reader for books, pasted text and locally saved progress.",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:web",
    "assets:generate": "node scripts/generate-raster-assets.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "build:web": "npm run notices:generate && node scripts/build-web.mjs",
    "build:native": "npm run build:web && node scripts/build-native.mjs",
    "build:extension": "node scripts/build-chrome-extension.mjs",
    "build:all": "npm run build:native",
    "cap:sync": "npm run build:native && cap sync",
    "verify:package": "node scripts/verify-packaged-assets.mjs",
    "verify:extension": "node scripts/verify-chrome-extension.mjs",
    "verify:brand": "node scripts/verify-brand.mjs",
    "verify:notices": "node scripts/verify-notices.mjs",
    "verify:precache": "node scripts/verify-service-worker-precache.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:determinism": "node scripts/verify-deterministic-build.mjs",
    "verify:store-copy": "node scripts/verify-store-copy.mjs",
    "verify:all": "npm run verify:brand && npm run verify:notices && npm run verify:package && npm run verify:android && npm run verify:extension && npm run verify:precache && npm run verify:deployment && npm run verify:determinism && npm run verify:store-copy",
    "verify:android": "node scripts/verify-android-package.mjs",
    "release:check": "npm run test:isolation && npm test && npm run test:extension && npm run test:visual && npm run test:lighthouse && npm run cap:sync && npm run verify:all",
    "ios:add": "npm run build && cap add ios",
    "ios:open": "npm run cap:sync && cap open ios",
    "test": "npm run test:unit && npm run test:production",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:isolation": "node tests/isolation/run-port-collision.mjs",
    "test:extension": "node tests/extension/chrome-extension.e2e.mjs",
    "test:production": "playwright test tests/test-production-regressions.spec.js tests/test-offline-production.spec.js --project=chromium",
    "typecheck": "node --check scripts/*.mjs",
    "lint": "npm run verify:all",
    "test:cross-browser": "playwright test tests/test-production-regressions.spec.js --project=webkit --project=mobile-safari",
    "test:visual": "npm run build:native && node tests/visual/capture-matrix.mjs",
    "test:lighthouse": "npm run build:web && node tests/performance/run-lighthouse.mjs",
    "test:local": "playwright test tests/test-production-regressions.spec.js --project=chromium",
    "test:headed": "playwright test tests/test-production-regressions.spec.js --project=chromium --headed",
    "test:debug": "playwright test tests/test-production-regressions.spec.js --project=chromium --debug",
    "test:prod": "playwright test --config=playwright.prod.config.js"
  },
  "keywords": [
    "rsvp",
    "speed-reading",
    "epub",
    "pwa",
    "offline",
    "reader"
  ],
  "author": "Vovka (DoroninDobroCorp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DoroninDobroCorp/RSVP_reader.git"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "^29.0.1",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
